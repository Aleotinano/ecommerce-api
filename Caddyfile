# Reverse proxy con TLS automático (Let's Encrypt) delante del backend.
# Lo consume el servicio `caddy` de docker-compose.prod.yml; {$VAR} se resuelve
# contra las env vars de ese servicio, no contra el .env directamente.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# HSTS lo pone el que termina el TLS; el resto de los headers de seguridad ya
	# los manda helmet desde la app, y repetirlos acá sólo crea dos fuentes de
	# verdad. Ojo: con `preload` esto es prácticamente irreversible, por eso no está.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Caddy setea X-Forwarded-For / -Proto solo. Del otro lado, TRUST_PROXY=1 hace
	# que Express lea ese header — los dos lados tienen que moverse juntos.
	reverse_proxy backend:3001 {
		# El backend tarda unos segundos en levantar (Prisma + conexión a Postgres).
		# `lb_try_duration` hace que Caddy reintente durante ese rato en vez de
		# devolverle un 502 seco al primer visitante después de un deploy.
		lb_try_duration 30s
		lb_try_interval 1s

		# Chequeo activo: marca el upstream como caído y evita mandarle tráfico
		# mientras no conteste. Con un solo upstream no hay a dónde balancear, pero
		# sí cambia el 502 por uno inmediato en vez de esperar el timeout.
		health_uri /health
		health_interval 10s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}
