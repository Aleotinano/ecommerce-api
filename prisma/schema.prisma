generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  categories         Categories[]
  products           Product[]
  variants           ProductVariant[]
  carts              Cart[]
  orders             Order[]
  config             TenantConfig?
  contentSuggestions ContentSuggestion[]
}

model TenantConfig {
  id       Int @id @default(autoincrement())
  tenantId Int @unique

  // Branding
  logoUrl          String?
  logoPublicId     String?
  storeName        String?
  storeDescription String?
  storeTagline     String?

  // Contacto
  contactEmail   String?
  contactPhone   String?
  contactAddress String?

  // Social media
  socialInstagram String?
  socialTiktok    String?
  socialFacebook  String?
  socialTwitter   String?
  socialYoutube   String?
  socialPinterest String?
  socialWhatsapp  String?

  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  // Políticas
  shippingPolicy String?
  returnsPolicy  String?
  privacyPolicy  String?

  // Configuración de tienda
  currency       String? @default("ARS")
  locale         String? @default("es-AR")
  showOutOfStock Boolean @default(false)
  allowCartGuest Boolean @default(true)

  // Seña / depósito: si depositEnabled es true, las órdenes del tenant exigen un
  // depósito (depositPercentage % del total) antes de pasar a producción.
  depositEnabled    Boolean @default(false)
  depositPercentage Int     @default(50)

  // WhatsApp Business: el `phone_number_id` del numero de la marca (Meta Graph
  // API). Identifica al tenant cuando llega un mensaje por el webhook de WhatsApp.
  whatsappPhoneNumberId String? @unique
  // Access token de la Graph API de la marca, cifrado AES-256-GCM (lib/crypto.js).
  // null = usar el token global de env (WHATSAPP_ACCESS_TOKEN).
  whatsappAccessToken   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id       Int    @id @default(autoincrement())
  tenantId Int
  username String
  email    String
  password String
  role     Role   @default(CUSTOMER)

  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  cart   Cart?
  orders Order[]
  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Categories {
  id          Int          @id @default(autoincrement())
  tenantId    Int
  name        String
  description String?
  icon        String?
  isActive    Boolean      @default(true)
  parentId    Int?
  parent      Categories?  @relation("CategoryToSubcategories", fields: [parentId], references: [id])
  children    Categories[] @relation("CategoryToSubcategories")
  products    Product[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id                 Int                 @id @default(autoincrement())
  tenantId           Int
  img                String?
  imgPublicId        String?
  name               String
  description        String?
  price              Float
  categoryId         Int?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  variants           ProductVariant[]
  category           Categories?         @relation(fields: [categoryId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  contentSuggestions ContentSuggestion[]

  @@index([tenantId])
}

model ProductVariant {
  id          Int         @id @default(autoincrement())
  tenantId    Int
  productId   Int
  color       String?
  size        String?
  price       Float?
  stock       Int
  sku         String
  img         String?
  imgPublicId String?
  isActive    Boolean     @default(true)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  tenantId  Int
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  items     CartItem[]

  @@index([tenantId])
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  cart      Cart           @relation(fields: [cartId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id            Int                  @id @default(autoincrement())
  tenantId      Int
  userId        Int?
  status        OrderStatus          @default(PENDING)
  total         Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User?                @relation(fields: [userId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  orderItems    OrderItem[]
  statusHistory OrderStatusHistory[]

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paymentId     String?
  mercadoPagoId String?       @unique
  preferenceId  String?

  // Procedencia + revisión (órdenes creadas por el bot nacen sin revisar).
  origin       OrderOrigin @default(ADMIN)
  contactPhone String? // wa_id del cliente de WhatsApp (órdenes BOT)
  contactName  String?
  reviewedById Int?
  reviewedAt   DateTime?

  // Seña / depósito: comportamiento opcional por tenant (TenantConfig.depositEnabled).
  // depositAmount es snapshot pactado al crear; NO se recalcula desde TenantConfig.
  requiresDeposit      Boolean   @default(false)
  depositAmount        Float?
  depositConfirmedById Int?
  depositConfirmedAt   DateTime?

  // Snapshot del fragmento de conversación que originó la orden (Redis tiene TTL).
  creationContext String?

  @@index([tenantId])
}

model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     Int
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById Int?
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id        Int            @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Float
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([orderId, variantId])
}

model ContentSuggestion {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  productId Int
  angle     SuggestionAngle
  status    SuggestionStatus  @default(SUGGESTED)
  source    SuggestionSource  @default(AUTO)
  date      DateTime          @db.Date

  // Campos de IA (Fase 2) — nullable por ahora
  copy        String?
  hashtags    String[]  @default([])
  model       String?
  generatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Identidad natural = dimension del cache on-demand (tenant+dia+producto+angulo).
  // Dedupe tanto la sugerencia automatica del dia como las generaciones manuales.
  @@unique([tenantId, date, productId, angle])
  @@index([tenantId])
}

enum SuggestionAngle {
  BEST_SELLER
  NEW_ARRIVAL
  LOW_STOCK
  NO_RECENT_SALES
}

enum SuggestionStatus {
  SUGGESTED
  USED
  DISMISSED
}

enum SuggestionSource {
  AUTO
  MANUAL
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROCESS
  REFUNDED
  DEPOSIT_PAID
  PAID_IN_FULL
}

enum OrderOrigin {
  ADMIN
  BOT
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}
