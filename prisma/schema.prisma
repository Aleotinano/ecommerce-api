generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  categories             Categories[]
  products               Product[]
  variants               ProductVariant[]
  attributes             TenantAttribute[]
  carts                  Cart[]
  orders                 Order[]
  config                 TenantConfig?
  contentSuggestions     ContentSuggestion[]
  pageSpec               TenantPageSpec?
  suggestionImages       SuggestionImage[]
  comboAllowedProducts   ComboAllowedProduct[]
  comboAllowedCategories ComboAllowedCategory[]
  promos                 Promo[]
  promoTiers             PromoTier[]
  promoProducts          PromoProduct[]
  userAddresses          UserAddress[]
  orderPayments          OrderPayment[]
  cashCategories         CashCategory[]
  cashSessions           CashRegisterSession[]
  cashMovements          CashMovement[]
  orderReceipts          OrderReceipt[]
}

model TenantConfig {
  id       Int @id @default(autoincrement())
  tenantId Int @unique

  // Branding
  logoUrl          String?
  logoPublicId     String?
  storeName        String?
  storeDescription String?
  storeTagline     String?

  // Contacto
  contactEmail   String?
  contactPhone   String?
  contactAddress String?

  // Social media
  socialInstagram String?
  socialTiktok    String?
  socialFacebook  String?
  socialTwitter   String?
  socialYoutube   String?
  socialPinterest String?
  socialWhatsapp  String?

  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?

  // Políticas
  shippingPolicy String?
  returnsPolicy  String?
  privacyPolicy  String?

  // Tema de la tienda (lo edita el tenant desde el admin). null en un campo = el
  // storefront usa su default para ESE campo. Se guardan como texto libre a
  // propósito: el catálogo de fuentes y los enums de forma/densidad viven en
  // @repo/shared y así evolucionan sin migración. La validación de entrada está
  // en tenant-config.schema.js, y el storefront vuelve a normalizar al renderizar
  // (normalizeStoreTheme) porque estos valores terminan en un atributo `style`.
  themeAccent      String?
  themeRadius      String?
  themeFontDisplay String?
  themeFontBody    String?
  // Peso por rol ("400".."700"). Lo hereda todo el texto que no fija el suyo.
  themeWeightDisplay String?
  themeWeightBody    String?
  themeDensity     String?

  // Overrides de estilo por sección (nav/hero/catalog/footer). JSON y no columnas
  // porque son 4 secciones x 6 ejes: 24 columnas nullables para algo que casi
  // siempre está vacío. La forma la valida Zod al escribir y `normalizeSectionThemes`
  // al renderizar — el contrato vive en @repo/shared y crece sin migración.
  themeSections Json?

  // Teléfono DEL CLIENTE (no confundir con `contactPhone`, que es el DEL NEGOCIO).
  // El rubro cambia la respuesta: una tienda con delivery lo necesita sí o sí,
  // una de productos digitales vive bien solo con el email.
  //   customerPhoneMode    off | optional | required (CHECK en la migración)
  //   customerPhoneCountry código de país, solo dígitos
  //   customerPhoneArea    característica por defecto (ej. "264"). Sirve para
  //                        COMPLETAR números locales cortos, NO para rechazar los
  //                        de otras provincias: la zona de reparto la define la
  //                        dirección, no el teléfono de quien paga.
  customerPhoneMode    String? @default("required")
  customerPhoneCountry String? @default("54")
  customerPhoneArea    String?

  // Configuración de tienda
  currency       String? @default("ARS")
  locale         String? @default("es-AR")
  showOutOfStock Boolean @default(false)
  allowCartGuest Boolean @default(true)

  // Todo PRODUCTO tiene siempre >=1 variante (la default); este flag no cambia eso.
  // Solo gatilla si el admin puede agregar MÁS de una variante (mostrar/ocultar
  // "Agregar variante" en el panel) — no se lee todavía del lado del backend.
  productVariantsEnabled Boolean @default(true)

  // ---- Flujo de venta: LO CONFIGURAMOS NOSOTROS, no el tenant ----
  // Estos campos deciden SI el tenant vende, cuándo una orden puede producirse y
  // cuánta plata se exige antes. No están en `updateTenantConfigObject` (ver
  // schemas/tenant-config.schema.js): si el admin del tenant pudiera cambiarlos,
  // podría trabar pedidos que ya están en curso. Se setean desde un perfil
  // (services/tenant-profiles.js) al crear el tenant, y después a mano con
  // `prisma/set-tenant-profile.js`.

  // Qué es la tienda para el cliente:
  //   SHOP  catálogo que se compra (default: todo como siempre)
  //   MENU  catálogo que se LEE — carta de restaurante o de cafetería. No hay
  //         carrito ni checkout; el pedido se cierra por fuera (WhatsApp, mostrador).
  // Es el más drástico de los campos de este bloque, y por eso el que más razón
  // tiene de estar acá: en MENU el storefront apaga /checkout entero. Un tenant
  // que se lo pudiera prender solo se quedaría sin ventas sin entender por qué.
  // Enum cerrado → CHECK en la migración, igual que customerPhoneMode.
  storeMode String @default("SHOP")

  // Métodos que el tenant acepta. Los enums de Zod (schemas/order.schema.js) son
  // los valores POSIBLES; estas dos listas son los HABILITADOS para este tenant,
  // y las valida `OrderModel.create`/`reviewOrder`. Los defaults reproducen el
  // comportamiento anterior a que existieran (todo habilitado), así que la
  // migración no cambia a ningún tenant existente.
  paymentMethodsEnabled     OrderPaymentMethod[] @default([CASH, TRANSFER, MIXED])
  fulfillmentMethodsEnabled FulfillmentMethod[]  @default([DELIVERY, PICKUP])

  // Seña / depósito: si depositEnabled es true, las órdenes del tenant exigen un
  // depósito (depositPercentage % del total) antes de pasar a producción.
  depositEnabled    Boolean @default(false)
  depositPercentage Int     @default(50)

  // Módulo de caja (services/cash-register.js). Opt-in por tenant: con el flag en
  // false NADA cambia — los endpoints devuelven 404 y los cobros de órdenes no
  // exigen turno abierto. Prendido, confirmar un cobro sin caja abierta FALLA, y
  // por eso también es de solo lectura para el tenant: apagarlo o prenderlo cambia
  // si se puede cobrar. No es parte de un perfil (services/tenant-profiles.js) a
  // propósito — reaplicar un perfil apagaría la caja de quien la tenga prendida.
  // Se setea con `node prisma/set-cash-register.js <slug> on|off`.
  cashRegisterEnabled Boolean @default(false)

  // Turnos con horario del tenant: `[{ label, from: "HH:MM", to: "HH:MM" }]`, ej.
  // mañana 08–14, tarde 14–20, noche 20–02 (`to < from` = cruza la medianoche).
  // Con esto cargado, un cobro en horario ABRE el turno solo si no hay ninguno
  // abierto (ver `ensureScheduledSession`), y el turno queda con fecha de
  // vencimiento. JSON y no tabla por el mismo motivo que `themeSections`: son 1 a 4
  // filas de tres campos, y la forma la valida Zod.
  //
  // Sí lo edita el tenant: un horario mal puesto no bloquea cobros —la apertura
  // automática solo DESBLOQUEA— así que no es una regla de plata.
  cashSchedule Json?

  // WhatsApp Business: el `phone_number_id` del numero de la marca (Meta Graph
  // API). Identifica al tenant cuando llega un mensaje por el webhook de WhatsApp.
  whatsappPhoneNumberId String? @unique
  // Access token de la Graph API de la marca, cifrado AES-256-GCM (lib/crypto.js).
  // null = usar el token global de env (WHATSAPP_ACCESS_TOKEN).
  whatsappAccessToken   String?

  // Cuenta de Cloudinary DEL CLIENTE. Cada cliente que sale a producción se crea
  // sus propias cuentas de servicios externos, pero el deploy es una instancia
  // multi-tenant única: no alcanza con un `.env` distinto, hay que resolver las
  // credenciales por tenant en runtime (ver lib/cloudinary.js).
  //
  // Los tres NULL = usar la cuenta global de env. Esa cuenta no es transitoria:
  // queda como cuenta de la plataforma. Los assets que un tenant subió ANTES de
  // cargar su cuenta se quedan en la global (no se migran).
  //
  // Van los tres o ninguno (CHECK en la migración): media credencial cargada es un
  // tenant que sube a ningún lado. Además el `api_secret` nunca vuelve en el GET,
  // así que el panel no puede editar uno solo aunque quisiera.
  cloudinaryCloudName String?
  // Cifradas AES-256-GCM (lib/crypto.js), igual que `whatsappAccessToken`.
  cloudinaryApiKey    String?
  cloudinaryApiSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id       Int    @id @default(autoincrement())
  tenantId Int
  username String
  email    String
  password String
  role     Role   @default(CUSTOMER)

  // Teléfono de contacto, en dígitos E.164 (ej. "5492644123456"). Nullable: las
  // cuentas creadas antes de que se pidiera no lo tienen, y el modo del tenant
  // puede ser "off". Se normaliza en lib/phone.js antes de guardar — acá nunca
  // entra texto libre. NO es una credencial: no se loguea con esto ni tiene
  // unique, dos personas de la misma casa pueden compartir número.
  phone    String?

  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  cart      Cart?
  orders    Order[]
  addresses UserAddress[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId])
}

// Libreta de direcciones del cliente del storefront ("mi casa", "casa de mi mamá"):
// evita retipear la dirección en cada pedido. NO es la dirección de la orden: al
// hacer checkout se copian estos campos a las columnas planas de Order, que es el
// snapshot histórico. Order NO tiene FK acá a propósito — borrar una dirección
// jamás puede alterar un pedido ya cerrado, así que el borrado es físico.
model UserAddress {
  id       Int    @id @default(autoincrement())
  tenantId Int
  userId   Int

  label String // como lo llama el cliente: "mi casa", "casa de mi mamá"

  // Mismos campos y límites que el bloque `fulfillmentFields` de
  // schemas/order.schema.js: esta tabla es la FUENTE de las columnas addressX
  // de Order. Hace falta addressText y/o addressMapsUrl (CHECK en la migración).
  addressText    String?
  addressLat     Float?
  addressLng     Float?
  addressDetails String?
  addressMapsUrl String?

  // Dirección preseleccionada en el checkout. "A lo sumo una por usuario" lo
  // garantiza un índice único PARCIAL que vive SOLO en la migración
  // `prisma/migrations/20260727120000_add_user_address/migration.sql` — mismo
  // motivo que `ProductVariant.isDefault`: no declararlo acá para no generar
  // drift en `migrate diff`.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // userId alcanza como scope del unique: un User pertenece a un solo tenant
  // (mismo razonamiento que `Cart.userId @unique`).
  @@unique([userId, label])
  @@index([tenantId])
  @@index([userId])
}

model Categories {
  id             Int                    @id @default(autoincrement())
  tenantId       Int
  name           String
  description    String?
  icon           String?
  imageUrl       String?
  imgPublicId    String?
  isActive       Boolean                @default(true)
  position       Int                    @default(0) // orden de display; ver TenantAttribute.position
  parentId       Int?
  parent         Categories?            @relation("CategoryToSubcategories", fields: [parentId], references: [id])
  children       Categories[]           @relation("CategoryToSubcategories")
  products       Product[]
  comboAllowedIn ComboAllowedCategory[]
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

// PRODUCTO: todo producto no-combo tiene siempre >=1 ProductVariant, marcada `isDefault`
// la principal — precio/stock se leen SIEMPRE de la variante, nunca de columnas propias
// de Product (ver `ProductVariant.isDefault`). COMBO: `Product.price` es su precio fijo;
// no tiene stock ni variantes propias (se valida/descuenta sobre los componentes
// elegidos). Ver docs/servicios/dominio/Productos.md y Combos.md.
enum ProductType {
  PRODUCTO
  COMBO
}

model Product {
  id                 Int                 @id @default(autoincrement())
  tenantId           Int
  img                String?
  imgPublicId        String?
  name               String
  description        String?
  // Exclusivo de COMBO (precio fijo del combo). Para PRODUCTO es siempre null — el
  // precio real vive en la variante default (ver `ProductVariant.isDefault`).
  price              Float?
  // Precio de lista ("antes"), para tachar y mostrar el ahorro: el descuento a mostrar
  // es `compareAtPrice - price`. Es un dato CARGADO, no calculado — en un combo es lo
  // que costarían sus componentes sueltos según la carta del local, y nadie lo recalcula
  // desde la whitelist (que define qué se puede elegir, no cuánto valdría). Sigue la
  // misma invariante que `price`: exclusivo de COMBO, siempre null para PRODUCTO. El día
  // que un PRODUCTO necesite precio tachado, el campo espejo va en `ProductVariant`,
  // donde vive su precio. Opcional: null = sin precio de lista, no se muestra nada.
  compareAtPrice     Float?
  categoryId         Int?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  variants           ProductVariant[]
  category           Categories?         @relation(fields: [categoryId], references: [id])
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  contentSuggestions ContentSuggestion[]
  cartItems          CartItem[]
  orderItems         OrderItem[]

  type ProductType

  // Combos: producto compuesto de otros productos, el cliente elige la selección
  // dentro del whitelist de `comboOptions` respetando comboMinItems/comboMaxItems
  // (unidades totales, no líneas distintas). Ver docs/servicios/dominio/Combos.md.
  // `isCombo` queda deprecado (reemplazado por `type = COMBO`) — no se lee en código,
  // se conserva la columna un tiempo por si hace falta re-derivar `type` a mano.
  isCombo              Boolean                @default(false)
  comboMinItems        Int?
  comboMaxItems        Int?
  comboOptions         ComboAllowedProduct[]  @relation("ComboOptions")
  allowedInCombos      ComboAllowedProduct[]  @relation("AllowedInCombos")
  comboCategoryOptions ComboAllowedCategory[] @relation("ComboCategoryOptions")

  // Promos de descuento por cantidad vinculadas a este producto (solo PRODUCTO,
  // nunca COMBO — ver services/promos.js). Ver [[Promo]] más abajo.
  promoLinks PromoProduct[]

  @@index([tenantId])
}

// Whitelist de productos permitidos dentro de un combo. `comboProduct` es el
// producto con isCombo=true; `allowedProduct` es cada opción elegible (nunca
// otro combo — sin anidamiento). Dos sabores según `comboAllowedCategoryId`:
// - null: regla standalone (legacy, ex sub-tab "Unidad" del admin) — minQty/maxQty
//   acotan cuánto de ESE producto puede elegirse dentro del combo.
// - no-null: MIEMBRO explícito de una regla de `ComboAllowedCategory` — marca
//   pertenencia ("de los brownies, solo A y B"); sus minQty/maxQty NO se usan,
//   la cantidad la gobierna la regla de la categoría (total del grupo).
// El @@unique(comboProductId, allowedProductId) garantiza que un producto no
// puede ser standalone y miembro a la vez dentro del mismo combo.
model ComboAllowedProduct {
  id                     Int      @id @default(autoincrement())
  tenantId               Int
  comboProductId         Int
  allowedProductId       Int
  comboAllowedCategoryId Int?
  // Fija la regla a UNA variante puntual del producto permitido. null = cualquier
  // variante activa (el comportamiento histórico, por eso la columna nace nullable y
  // la migración no toca datos). Con valor, `validateComboSelection` rechaza cualquier
  // otra con COMBO_VARIANT_NOT_ALLOWED: es lo que permite expresar "el pack lleva la
  // caja x48" sin que el cliente pueda meter la x12.
  // Cascade igual que `allowedProductId`: si la variante fijada desaparece, la regla se
  // va con ella. La alternativa (SetNull) volvería a habilitar TODAS las variantes en
  // silencio, que es justo el bug que esta columna cierra.
  allowedVariantId       Int?
  minQty                 Int      @default(0)
  maxQty                 Int?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  comboProduct     Product               @relation("ComboOptions", fields: [comboProductId], references: [id], onDelete: Cascade)
  allowedProduct   Product               @relation("AllowedInCombos", fields: [allowedProductId], references: [id], onDelete: Cascade)
  allowedVariant   ProductVariant?       @relation("AllowedVariantInCombos", fields: [allowedVariantId], references: [id], onDelete: Cascade)
  memberOfCategory ComboAllowedCategory? @relation("CategoryMembers", fields: [comboAllowedCategoryId], references: [id], onDelete: Cascade)
  tenant           Tenant                @relation(fields: [tenantId], references: [id])

  @@unique([comboProductId, allowedProductId])
  @@index([tenantId])
  @@index([comboProductId])
  @@index([comboAllowedCategoryId])
  @@index([allowedVariantId])
}

// Whitelist de CATEGORÍAS permitidas dentro de un combo (ej. "el combo lleva 4 de
// la categoría Brownies"). minQty/maxQty son el TOTAL DEL GRUPO: la suma de las
// cantidades elegidas de esa categoría debe caer en [minQty, maxQty] (el admin
// manda minQty = maxQty = cantidad exacta). `members` son los productos puntuales
// permitidos dentro de la categoría (filas de `ComboAllowedProduct` con
// `comboAllowedCategoryId`); sin miembros = todos los productos activos de la
// categoría. `Product.comboMinItems`/`comboMaxItems` se derivan de la suma de
// estas reglas al guardar. No baja a subcategorías.
model ComboAllowedCategory {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  comboProductId Int
  categoryId     Int
  minQty         Int      @default(0)
  maxQty         Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  comboProduct Product               @relation("ComboCategoryOptions", fields: [comboProductId], references: [id], onDelete: Cascade)
  category     Categories            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  members      ComboAllowedProduct[] @relation("CategoryMembers")
  tenant       Tenant                @relation(fields: [tenantId], references: [id])

  @@unique([comboProductId, categoryId])
  @@index([tenantId])
  @@index([comboProductId])
  @@index([categoryId])
}

// Descuento por cantidad sobre productos específicos (nunca COMBO — precio fijo,
// no tiene sentido "por cantidad de variante"; se valida al crear/editar). Escalones
// (`tiers`) van de menor a mayor `minQty`; al pricear se aplica el de mayor `minQty`
// que la cantidad total del producto (sumando TODAS sus variantes) todavía cumple —
// ver `getPromoTiersByProduct`/`pickPromoTier` en services/promos.js. Un producto
// puede estar a lo sumo en una Promo activa a la vez; se valida a nivel servicio
// (cruza `Promo.isActive` + `PromoProduct`, no representable como constraint de una
// sola tabla) en vez de un índice parcial. Sin rango de fechas/agendado: fuera de
// alcance v1, no se pidió.
model Promo {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  tiers    PromoTier[]
  products PromoProduct[]

  @@index([tenantId])
}

model PromoTier {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  promoId            Int
  minQty             Int
  discountPercentage Float
  createdAt          DateTime @default(now())

  promo  Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([promoId, minQty])
  @@index([tenantId])
}

// Join promo<->producto. Sin `isActive` propio: el estado vive en `Promo.isActive`.
// `@@index([productId])` es el hot path real (pricear resuelve "dados estos
// productIds, su promo activa"), a diferencia de `ComboAllowedProduct` que siempre
// busca por `comboProductId`.
model PromoProduct {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  promoId   Int
  productId Int
  createdAt DateTime @default(now())

  promo   Promo   @relation(fields: [promoId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  @@unique([promoId, productId])
  @@index([tenantId])
  @@index([productId])
}

// Tipo de valor de un atributo de variante del tenant.
enum AttributeType {
  TEXT
  COLOR // valor HEX (#RGB/#RRGGBB), para swatch en el storefront
}

// Catálogo de atributos de variante del tenant (ropa: color+talle; mesa dulce:
// sabor+tamaño). Se define UNA sola vez en el onboarding (el setup devuelve 409 si
// ya existe) — cambiarlo después dejaría inconsistentes las `attributes` de las
// variantes existentes. Las keys son slugs estables en minúsculas; `label` es lo
// que ve el cliente. Ver services/tenant-attributes.js.
model TenantAttribute {
  id       Int           @id @default(autoincrement())
  tenantId Int
  key      String // slug estable: "color", "talle", "sabor"
  label    String // display: "Color", "Talle", "Sabor"
  type     AttributeType @default(TEXT)
  position Int           @default(0) // orden de display y de normalización de keys

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model ProductVariant {
  id          Int         @id @default(autoincrement())
  tenantId    Int
  productId   Int
  // Atributos de la variante como pares key->valor (ej: {"color":"#fff","talle":"M"}).
  // Las keys deben existir en el catálogo `TenantAttribute` del tenant; se validan y
  // normalizan (orden por `position`) en el service, nunca se escriben crudas.
  attributes  Json        @default("{}")
  price       Float
  stock       Int
  sku         String
  img         String?
  imgPublicId String?
  isActive    Boolean     @default(true)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]

  // Reglas de combo que fijan ESTA variante como la única elegible de su producto.
  allowedInCombos ComboAllowedProduct[] @relation("AllowedVariantInCombos")

  // Marca la variante "principal" de un Product tipo PRODUCTO — todo producto no-combo
  // tiene siempre exactamente una. El índice único parcial que garantiza "a lo sumo una
  // por producto" vive SOLO en la migración
  // `prisma/migrations/<ts>_product_types_collapse_expand/migration.sql`
  // (mismo motivo que el de CartItem más abajo: no declararlo acá para no generar drift
  // en `migrate diff`).
  isDefault Boolean @default(false)

  @@unique([tenantId, sku])
  @@index([tenantId])
}

// Un Cart pertenece a un User autenticado (userId) O a un guest anónimo (guestId),
// nunca ambos ni ninguno — reforzado con un CHECK constraint agregado a mano en la
// migración `prisma/migrations/<ts>_cart_guest_support/migration.sql` (mismo motivo
// que otros constraints de este schema: no declararlo acá para no generar drift en
// `migrate diff`). guestId identifica un carrito anónimo vía cookie httpOnly (ver
// middleware/guestCart.js); al loguearse se fusiona con el Cart del User y se borra
// (ver CartModel.mergeGuestCartIntoUser).
model Cart {
  id        Int        @id @default(autoincrement())
  tenantId  Int
  userId    Int?       @unique
  guestId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  items     CartItem[]

  // guestId se escopa por tenant (a diferencia de userId, ya único globalmente porque
  // cada User pertenece a un solo tenant): el mismo browser/cookie puede navegar más
  // de un tenant (resolveTenantFromSlug también acepta header X-Tenant-Slug), así que
  // necesita un Cart de invitado distinto por tenant.
  @@unique([tenantId, guestId])
  @@index([tenantId])
}

// `variantId` es NULL solo para líneas de producto COMBO (un PRODUCTO siempre resuelve
// su variante, default o explícita). El `@@unique` de abajo cubre el caso variantId
// no-null; el caso NULL (COMBO) lo cubre un índice único PARCIAL agregado a mano en la
// migración `prisma/migrations/20260708190000_product_types_add/migration.sql` (Postgres
// no colisiona NULL contra NULL en un unique normal) — no lo declares acá ni lo borres
// pensando que es drift, ver ese archivo de migración.
model CartItem {
  id        Int             @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  cart      Cart            @relation(fields: [cartId], references: [id])
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  // Combos: selección elegida por el cliente para ESTE combo, `[{ productId,
  // variantId?, quantity }]` por una unidad de combo. Se resuelve/valida server-side
  // al agregar (services/combos.js) y se vuelve a validar al pasar a orden — nunca
  // se confía en este JSON al leerlo. null para líneas que no son combo.
  comboSelection Json?

  @@unique([cartId, productId, variantId])
}

model Order {
  id            Int                  @id @default(autoincrement())
  tenantId      Int
  userId        Int?
  status        OrderStatus          @default(NEW)
  total         Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User?                @relation(fields: [userId], references: [id])
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  orderItems    OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      OrderPayment[]
  receipts      OrderReceipt[]

  paymentStatus PaymentStatus       @default(PENDING)
  paymentMethod OrderPaymentMethod?
  paymentId     String?
  mercadoPagoId String?             @unique
  preferenceId  String?
  // Nota libre para el detalle de pago mixto (ej. "transfiere 5000, resto
  // efectivo"). El software no gestiona el dinero: es solo información para
  // quien revisa el pago manualmente.
  paymentNote   String?

  // Desglose del pago mixto: cuánto va en efectivo y cuánto por transferencia.
  // Solo se llenan si paymentMethod = MIXED, y su suma debe igualar `total`.
  // La suma se valida en el service (services/orders.js), no en Zod: el total
  // se calcula server-side desde el carrito, el cliente nunca lo fija.
  cashAmount     Float?
  transferAmount Float?

  // Transferencia: la confirma un asistente humano tras revisarla a mano —
  // no hay verificación automática. Solo aplica si paymentMethod ∈
  // {TRANSFER, MIXED}. Independiente de paymentStatus (MercadoPago).
  transferConfirmedById Int?
  transferConfirmedAt   DateTime?

  // Cobro total confirmado a mano: cierra el eje del dinero para los tenants que
  // no usan MercadoPago (efectivo/transferencia). Sin esto `paymentStatus` se
  // quedaba en PENDING para siempre —incluso en órdenes entregadas— porque
  // PAID_IN_FULL no lo escribía ningún flujo. Lo sella un humano, igual que la
  // seña y la transferencia; el software sigue sin verificar que la plata entró.
  paymentConfirmedById Int?
  paymentConfirmedAt   DateTime?

  // Entrega: retiro en local o envío a una dirección. Los campos de
  // dirección solo son relevantes si fulfillmentMethod = DELIVERY.
  fulfillmentMethod FulfillmentMethod?
  addressText       String?
  addressLat        Float?
  addressLng        Float?
  addressDetails    String? // ej. "rejas grises", referencia para el repartidor
  // Link de Google Maps pegado por el cliente (el que comparte desde su
  // teléfono). Alternativa o complemento de addressText: si fulfillmentMethod
  // es DELIVERY hace falta al menos uno de los dos. No hay geocoding
  // server-side: el link se guarda tal cual y solo se valida el host.
  addressMapsUrl    String?

  // Procedencia + revisión (solo las órdenes ADMIN nacen ya validadas: las de
  // BOT y STORE las carga el cliente y necesitan el OK de un humano).
  origin       OrderOrigin @default(ADMIN)
  contactPhone String? // wa_id del cliente de WhatsApp (órdenes BOT)
  contactName  String?
  reviewedById Int?
  reviewedAt   DateTime?

  // Seña / depósito: comportamiento opcional por tenant (TenantConfig.depositEnabled).
  // depositAmount es snapshot pactado al crear; NO se recalcula desde TenantConfig.
  requiresDeposit      Boolean   @default(false)
  depositAmount        Float?
  depositConfirmedById Int?
  depositConfirmedAt   DateTime?

  // Snapshot del fragmento de conversación que originó la orden (Redis tiene TTL).
  creationContext String?

  // Archivado: la orden sale del tablero, NO de la base. Es un filtro de
  // visibilidad —el listado del backoffice excluye lo archivado por defecto— y no
  // un borrado ni un estado: agregar `ARCHIVED` al enum habría roto el pipeline
  // congelado de `ORDER_STATUS_CODES`, los contadores y la distribución de
  // Estadísticas, que asumen que todo estado es un paso del flujo.
  //
  // Lo sella el CIERRE DEL TURNO DE CAJA y solo sobre estados terminales
  // (COMPLETED/CANCELLED, ver ARCHIVABLE_STATUSES en services/orders.js). Una
  // orden abierta no se archiva nunca: esconderla es exactamente cómo se pierde
  // un pedido, y que se vea vieja en el tablero ES la alarma.
  //
  // Los tres campos viajan juntos (CHECK en la migración `20260801120000_order_archive`,
  // no declarable acá): sin `archivedAt` no puede haber ni autor ni turno.
  archivedAt   DateTime?
  archivedById Int?

  // Turno de caja que la archivó — el "día" al que pertenece. Es lo que hace que
  // el historial de órdenes se pueda leer desde Caja (turno → sus órdenes) sin
  // depender de `CashMovement.orderId`, que solo existe si hubo un cobro por el
  // cajón: una cancelada, una de MercadoPago (GATEWAY se saltea) o una entregada
  // sin cobrar no tienen movimiento y se caerían del historial.
  //
  // Sin FK a propósito, mismo criterio que `CashMovement.orderId`: es un hecho
  // histórico y no puede arrastrar un cascade.
  cashSessionId Int?

  @@index([tenantId])
  @@index([tenantId, archivedAt])
  @@index([tenantId, cashSessionId])
}

// Libro de cobros de la orden: UNA FILA POR COBRO. Es lo que permite responder
// "¿cuánto se cobró de esta orden y por qué vía?" — antes el dinero solo existía
// como sellos (`depositConfirmedAt`, `transferConfirmedAt`, `paymentConfirmedAt`),
// banderas con fecha que no dicen monto. `Order.paymentStatus` pasa a DERIVARSE de
// estas filas (`derivePaymentStatus`, services/order-state.js) y se cachea en la
// columna para que los listados puedan seguir filtrando por SQL.
//
// El software sigue sin gestionar dinero: nadie verifica que la plata entró. Esto
// registra lo que un humano declaró cobrado, con monto y vía.
model OrderPayment {
  id       Int @id @default(autoincrement())
  tenantId Int
  orderId  Int

  kind    OrderPaymentKind
  channel PaymentChannel
  // SIEMPRE positivo (CHECK en la migración); el signo lo aporta `kind` vía
  // PAYMENT_SIGN. Guardar montos con signo invita a que alguien escriba -50 en un
  // cobro y nadie se entere hasta que no cierran las cuentas.
  amount  Float

  note          String?
  confirmedById Int? // null en los cobros que registra el webhook de MercadoPago
  confirmedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  receipts OrderReceipt[]

  @@index([orderId])
  @@index([tenantId])
}

// Comprobante de una transferencia: el archivo que miró un humano para dar el
// cobro por bueno. Cierra el hueco de que `transferConfirmedAt` decía CUÁNDO se
// confirmó pero no QUÉ se miró.
//
// Vive en su propia tabla y no como columna de `Order` ni de `OrderPayment`, por
// dos razones que se refuerzan:
//   - Una orden MIXED, o una con seña por transferencia más el saldo también por
//     transferencia, tiene DOS comprobantes distintos. Un campo en `Order` no los
//     cubre.
//   - La fila del libro de cobros no existe hasta que alguien confirma
//     (`applyPayments`), así que colgarlo de `OrderPayment` dejaría sin lugar al
//     estado "hay comprobante cargado, falta confirmar" — que es justamente el
//     estado que el panel necesita mostrar.
//
// Subir NO confirma: el comprobante es evidencia y la confirmación la sigue
// haciendo una persona que mira la cuenta. Los comprobantes se falsifican en dos
// minutos, y además confirmar dispara el avance automático de la orden.
model OrderReceipt {
  id       Int @id @default(autoincrement())
  tenantId Int
  orderId  Int

  // Se llena cuando un humano CONFIRMA usando este archivo (ver `linkReceiptIds`
  // en services/orders.js). Null = evidencia cargada, todavía sin confirmar.
  // NO es unique a propósito: el cliente puede mandar dos capturas de la misma
  // transferencia, y las dos son evidencia de ese mismo cobro.
  orderPaymentId Int?

  // Con qué ubicar y firmar el archivo en el proveedor. **No se guarda una URL
  // usable**: un comprobante lleva CBU, nombre y a veces el saldo de la cuenta, así
  // que las URLs se emiten firmadas y con expiración en cada respuesta
  // (lib/storage). Persistir el link lo volvería legible para siempre por
  // cualquiera que lo viera una vez.
  storageProvider String  @default("cloudinary")
  // En QUÉ cuenta del proveedor quedó el archivo. `null` = la cuenta global de env
  // (todas las filas anteriores a que existieran cuentas por tenant).
  //
  // No es redundante con `tenantId`: el tenant puede cargar su propia cuenta de
  // Cloudinary DESPUÉS de haber recibido comprobantes, y los viejos se quedan en la
  // global. Firmar con la cuenta equivocada no da error — da una URL que 404ea al
  // abrirla, y del otro lado hay un CBU que alguien necesita mirar.
  cloudName       String?
  publicId        String
  resourceType    String // "image" | "raw" — el PDF va como raw
  deliveryType    String // "authenticated" | "private"
  format          String?
  mimeType        String
  bytes           Int
  originalName    String?

  note         String?
  uploadedById Int?
  createdAt    DateTime @default(now())

  // Soft-delete: el HECHO de que hubo un archivo es inmutable (alguien confirmó
  // mirando algo), pero el dato personal se borra de verdad del proveedor. La
  // inmutabilidad del libro de cobros es sobre PLATA; un adjunto equivocado con el
  // CBU de un tercero no tiene por qué quedar para siempre.
  deletedAt   DateTime?
  deletedById Int?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderPayment OrderPayment? @relation(fields: [orderPaymentId], references: [id], onDelete: SetNull)
  tenant       Tenant        @relation(fields: [tenantId], references: [id])

  @@index([orderId])
  @@index([tenantId])
  @@index([orderPaymentId])
  // Lo usa la purga por antigüedad (`purgeExpired`, services/order-receipts.js).
  @@index([tenantId, createdAt])
}

model OrderStatusHistory {
  id          Int           @id @default(autoincrement())
  orderId     Int
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById Int?
  trigger     StatusTrigger @default(MANUAL)
  createdAt   DateTime      @default(now())
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// `variantId` es NULL solo para líneas de producto COMBO (no tienen variante propia);
// `productId` siempre está presente e identifica el producto de la línea.
model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int
  productId Int
  variantId Int?
  quantity  Int
  price     Float
  note      String?
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  // Combos: la fila "padre" (productId = el combo, price = precio fijo del combo,
  // sin variantId) tiene childItems, una fila por componente elegido (productId +
  // variantId? del componente real, price = 0, el cobro ya está en el padre).
  // parentItemId null = línea normal o línea padre de combo.
  parentItemId Int?
  parentItem   OrderItem?  @relation("ComboItems", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItems   OrderItem[] @relation("ComboItems")

  @@index([orderId, variantId])
  @@index([orderId, productId])
  @@index([parentItemId])
}

// ---------------------------------------------------------------------------
// Caja registradora (services/cash-register.js)
// ---------------------------------------------------------------------------

// Catálogo de etiquetas de movimiento del tenant. Mismo patrón que
// `TenantAttribute`: el tenant define su propia taxonomía ("Sueldos", "Insumos",
// "Proveedores") y cada movimiento manual apunta a una. Es lo que hace que se
// pueda responder "cuánto gasté en insumos este mes" sin leer notas a ojo.
//
// No se borra una etiqueta con movimientos (FK Restrict + chequeo explícito): se
// desactiva. Un movimiento de hace tres meses tiene que seguir diciendo qué era.
model CashCategory {
  id       Int    @id @default(autoincrement())
  tenantId Int
  key      String // slug estable: "sueldos", "insumos"
  label    String // display: "Sueldos", "Insumos"
  // A qué dirección aplica: "Sueldos" no es un ingreso jamás. Se valida al crear
  // el movimiento (CASH_CATEGORY_KIND_MISMATCH).
  applies  CashCategoryApplies @default(EXPENSE)
  position Int                 @default(0)
  isActive Boolean             @default(true)

  // Etiqueta RESERVADA del sistema ("venta", "devolucion"): la usa el enganche con
  // el libro de cobros para que los movimientos de orden también queden etiquetados
  // y el resumen por etiqueta cubra el 100% de la plata.
  //
  // No se borra, no se desactiva y no se le cambia `applies` —si alguien pudiera,
  // el próximo cobro de una orden quedaría archivado como gasto o fallaría—, pero SÍ
  // se puede renombrar: el `label` es texto visible y cada rubro le dice distinto.
  // Tampoco se ofrece para movimientos manuales: "Venta" significa exactamente
  // "cobro de una orden".
  isSystem Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements CashMovement[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

// Turno de caja física. NO es un día calendario: es un turno explícito
// (apertura -> cierre), lo que evita por completo el problema de zona horaria que
// tiene Estadísticas para definir "hoy".
//
// El software sigue sin gestionar dinero: no verifica que la plata exista, igual
// que las confirmaciones de cobro de una orden. Lleva la cuenta de lo que un
// humano declaró y muestra la diferencia.
model CashRegisterSession {
  id       Int               @id @default(autoincrement())
  tenantId Int
  status   CashSessionStatus @default(OPEN)

  // Los dos saldos con los que arranca el turno. Pueden ser NEGATIVOS: no porque
  // alguien los declare así (Zod lo rechaza) sino porque arrastran el cierre anterior,
  // y un turno que terminó con el esperado en negativo —falta registrar un ingreso—
  // tiene que seguir mostrando ese desvío en vez de que la caja lo redondee a 0.
  openingAmount Float // efectivo declarado al abrir
  // La caja lleva DOS saldos continuos: el efectivo del cajón y lo que hay en la
  // cuenta. El local piensa su caja con esas dos columnas. Default 0 por los turnos
  // anteriores a que existiera este saldo (ahí las transferencias solo se acumulaban
  // dentro de cada turno).
  openingTransferAmount Float @default(0)
  // Nullable por la apertura automática: cuando la abre el horario no hay persona
  // detrás. En una apertura manual siempre está.
  openedById    Int?
  openedAt      DateTime @default(now())
  openingNote   String?

  // Quién lo abrió: una persona o el horario del tenant (`cashSchedule`). Mismo
  // criterio que `StatusTrigger` en el historial de órdenes: nadie tiene que
  // adivinar si esto lo hizo un humano.
  trigger CashSessionTrigger @default(MANUAL)

  // Nombre y fin del turno del horario que lo abrió, MATERIALIZADOS al abrir (como
  // los perfiles de venta): editar el horario no puede mover retroactivamente el
  // vencimiento de un turno que ya está corriendo. Null en los turnos manuales sin
  // horario configurado.
  label     String?
  expiresAt DateTime?

  // Todo lo del cierre es null mientras status = OPEN (CHECK en la migración).
  closedById  Int?
  closedAt    DateTime?
  closingNote String?

  // Turno cerrado SIN que nadie contara la plata: lo cierra el sistema cuando venció
  // y ya arrancó el siguiente. `countedCashAmount`/`cashDifference` quedan en null a
  // propósito —"nunca se contó" y "contó y no cuadró" son cosas distintas— y el
  // CHECK de completitud del cierre lo admite solo en este caso.
  closedWithoutCount Boolean @default(false)

  // Snapshots calculados AL CERRAR, no se recalculan nunca (mismo criterio que
  // `Order.depositAmount` y el precio de `OrderItem`): si mañana se corrige un
  // movimiento viejo, el arqueo de ayer tiene que seguir diciendo lo que dijo.
  countedCashAmount  Float? // lo que la persona contó a mano
  expectedCashAmount Float? // openingAmount + Σ movimientos CASH con signo
  cashDifference     Float? // contado − esperado (negativo = falta plata)
  transferTotal      Float? // Σ movimientos TRANSFER del turno — el NETO, sin la apertura

  // El efectivo contado se parte en dos al cerrar: lo que se lleva la persona y lo que
  // deja en el cajón. La CAJA CHICA es la que abre el turno siguiente (`openingAmount`)
  // y la que arrastra una apertura manual — no lo contado: en el local la plata se
  // retira todos los días y queda un fondo para arrancar.
  //
  // `pettyCashAmount` es derivado (contado − retirado) pero se guarda igual: es parte
  // del arqueo firmado, y recalcularlo mañana a partir de un snapshot sería recalcular
  // un snapshot. Los dos quedan en null cuando nadie contó.
  withdrawnCashAmount Float? // caja grande: lo que se retira
  pettyCashAmount     Float? // caja chica: lo que queda

  // El mismo arqueo, para el saldo de transferencias. `expectedTransferAmount` SÍ
  // incluye la apertura (`openingTransferAmount` + `transferTotal`): son dos números
  // distintos y confundirlos duplica plata.
  //
  // El conteo de transferencias es OPCIONAL: un local que no chequea el banco al
  // cerrar deja `countedTransferAmount`/`transferDifference` en null en vez de firmar
  // una diferencia que nadie miró. Por eso el CHECK de completitud del cierre no los
  // exige (y los turnos anteriores a esta columna tampoco los tienen).
  expectedTransferAmount Float?
  countedTransferAmount  Float?
  transferDifference     Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements CashMovement[]
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Una sola sesión OPEN por tenant: índice único PARCIAL, declarado solo en la
  // migración (Prisma no soporta parciales y generaría drift en `migrate diff`),
  // mismo motivo que "UserAddress_user_default_key".
  @@index([tenantId])
  @@index([tenantId, status])
}

// Un movimiento de plata del turno. Los ORDER_* los crea SOLO el servicio de
// órdenes (uno por fila del libro de cobros que no sea GATEWAY); INCOME/EXPENSE
// son los manuales del local: sueldos, insumos, retiros, aportes de cambio.
model CashMovement {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  sessionId Int
  type      CashMovementType
  // Se reusa `PaymentChannel` en vez de un enum propio para que copiar una fila
  // del libro de cobros sea directo. GATEWAY está prohibido por CHECK: esa plata
  // no pasa por el cajón y contarla rompería el arqueo.
  channel   PaymentChannel
  // SIEMPRE positivo (CHECK en la migración); el signo lo aporta `type` vía
  // CASH_MOVEMENT_SIGN (services/cash-register-math.js).
  amount    Float

  // Etiqueta del movimiento: obligatoria en los manuales (lo exige Zod), null en
  // los ORDER_*, que ya se explican por su `type` y su `orderId`.
  categoryId Int?
  // A quién se le pagó / de quién entró: "Juan", "Panadería López". Texto libre a
  // propósito — el repartidor al que se le paga el día no es un User del sistema.
  payee      String?

  // Presentes solo en movimientos derivados de una orden. Sin FK a propósito,
  // mismo criterio que UserAddress↔Order: el movimiento es un hecho histórico de
  // caja y no puede depender de que la orden siga existiendo.
  orderId Int?
  // La fila del libro que originó este movimiento. UNIQUE = idempotencia
  // estructural del enganche: ni dos requests concurrentes pueden anotar el mismo
  // cobro dos veces. Postgres admite varios NULL en un índice único, así que los
  // movimientos manuales no se estorban entre sí.
  orderPaymentId Int? @unique

  note        String?
  createdById Int?
  createdAt   DateTime @default(now())

  session  CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category CashCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([sessionId])
  @@index([orderId])
  @@index([categoryId])
}

model ContentSuggestion {
  id        Int              @id @default(autoincrement())
  tenantId  Int
  productId Int
  angle     SuggestionAngle
  status    SuggestionStatus @default(SUGGESTED)
  source    SuggestionSource @default(AUTO)
  date      DateTime         @db.Date

  // Campos de IA (Fase 2) — nullable por ahora
  copy        String?
  hashtags    String[]  @default([])
  model       String?
  generatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  product Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  SuggestionImage[]

  // Identidad natural = dimension del cache on-demand (tenant+dia+producto+angulo).
  // Dedupe tanto la sugerencia automatica del dia como las generaciones manuales.
  @@unique([tenantId, date, productId, angle])
  @@index([tenantId])
}

// Spec del Page Builder por tenant: borrador editable + publicado que sirve el storefront.
// El publishedSpec se guarda YA normalizado (frontera on-write); el draftSpec es lo que
// edita el admin/IA. Ver docs/page-builder (repo frontend).
model TenantPageSpec {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @unique
  draftSpec     Json?
  publishedSpec Json?
  version       Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Variantes de imagen publicitaria generadas por IA para una sugerencia (1->N).
// Cada generacion produce varias variantes; el usuario elige una (chosen=true) y
// las otras se limpian (Cloudinary + DB). La imagen base se guarda LIMPIA: el
// texto/precio en pantalla se aplica como overlay al mostrar/descargar, no se
// quema en el asset. Ver docs: "Sugerencias de contenido — Imagenes (propuesta)".
model SuggestionImage {
  id            Int      @id @default(autoincrement())
  suggestionId  Int
  tenantId      Int
  imageUrl      String // secure_url de Cloudinary
  imagePublicId String // para poder borrar el asset
  options       Json     @default("{}") // { imagen, infoEnPantalla, precioEnPantalla }
  model         String? // modelo de imagen usado (null si hubo degradacion)
  prompt        String // prompt final que genero la variante (trazabilidad)
  chosen        Boolean  @default(false)
  createdAt     DateTime @default(now())

  suggestion ContentSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  tenant     Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([suggestionId])
}

enum SuggestionAngle {
  BEST_SELLER
  NEW_ARRIVAL
  LOW_STOCK
  NO_RECENT_SALES
}

enum SuggestionStatus {
  SUGGESTED
  USED
  DISMISSED
}

enum SuggestionSource {
  AUTO
  MANUAL
}

// Eje de producción. READY es opcional en el camino (PROCESSING -> COMPLETED sigue
// siendo válido): es el momento en que el pedido está terminado y se le avisa al
// cliente, que hasta ahora quedaba tapado dentro de PROCESSING. El stock se sigue
// descontando SOLO en COMPLETED. Transiciones válidas: services/order-state.js.
//
// `NEW` se llamó `PENDING` hasta 2026-07-31. Es lo que siempre fue —la bandeja de
// entrada: nadie puede volver acá y el motor saca la orden sola en cuanto deja de
// faltarle algo—, pero "pendiente" se leía como "trabada" y el panel terminaba
// traduciéndolo a "Nueva" al mostrarlo. Los textos de cada estado (panel, cliente,
// email) viven en un solo lugar: services/order-status.js.
enum OrderStatus {
  NEW
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

// Quién movió el estado: una persona (MANUAL), el motor al cumplirse las
// condiciones de la orden (AUTO, ver `applyAutoAdvance`) o el webhook de
// MercadoPago (GATEWAY). Sin esto, el timeline no distingue un avance automático
// de uno que alguien apretó, que es justo lo que hay que poder auditar cuando el
// cliente pregunta "¿quién puso esto en producción?".
enum StatusTrigger {
  MANUAL
  AUTO
  GATEWAY
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROCESS
  REFUNDED
  DEPOSIT_PAID
  PAID_IN_FULL
}

enum OrderOrigin {
  ADMIN
  BOT
  STORE
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

// Forma de pago ACORDADA para la orden entera. No confundir con `PaymentChannel`,
// que es la vía por la que entró CADA cobro: una orden MIXED genera dos filas de
// `OrderPayment`, una CASH y una TRANSFER.
enum OrderPaymentMethod {
  CASH
  TRANSFER
  MIXED
}

// Vía por la que se movió la plata de un cobro concreto. `GATEWAY` es MercadoPago:
// esa plata nunca pasa por el mostrador, así que un módulo de caja física debe
// ignorarla (ver [[Caja]]).
enum PaymentChannel {
  CASH
  TRANSFER
  GATEWAY
}

// Qué representa la fila del libro. `REFUND` es el único con signo negativo, y lo
// aporta `PAYMENT_SIGN` (services/order-state.js), no el número guardado.
enum OrderPaymentKind {
  DEPOSIT // seña
  PAYMENT // cobro (parcial o total)
  REFUND  // devolución al cliente
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// Quién abrió el turno. "Vencido" NO es un estado: se deriva de `expiresAt < now`
// sobre un turno OPEN, así no hace falta un job que lo escriba.
enum CashSessionTrigger {
  MANUAL
  AUTO
}

// Tipo de movimiento de caja. El signo NO se guarda: lo deriva
// CASH_MOVEMENT_SIGN (services/cash-register-math.js) a partir de este enum, y
// `amount` es SIEMPRE positivo. Guardar montos con signo invita a que un caller
// escriba -50 en un ingreso y nadie se entere hasta el arqueo.
//
// No se reusa `OrderPaymentKind` (una columna no puede tener dos enums) porque la
// caja necesita además sus dos tipos propios, los manuales.
enum CashMovementType {
  ORDER_DEPOSIT // seña cobrada de una orden                       → +
  ORDER_PAYMENT // cobro de una orden                              → +
  ORDER_REFUND  // devolución al cliente                           → −
  INCOME        // ingreso manual (aporte de cambio, venta suelta) → +
  EXPENSE       // egreso manual (sueldos, insumos, retiro)        → −
}

// Dirección a la que aplica una etiqueta de caja. BOTH existe para las que van en
// los dos sentidos ("Ajuste", "Otro").
enum CashCategoryApplies {
  INCOME
  EXPENSE
  BOTH
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}
