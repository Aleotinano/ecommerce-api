generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  categories Categories[]
  products   Product[]
  variants   ProductVariant[]
  carts      Cart[]
  orders     Order[]
  config     TenantConfig?
}

model TenantConfig {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @unique

  // Branding
  logoUrl          String?
  logoPublicId     String?
  storeName        String?
  storeDescription String?
  storeTagline     String?

  // Contacto
  contactEmail     String?
  contactPhone     String?
  contactAddress   String?

  // Social media
  socialInstagram  String?
  socialTiktok     String?
  socialFacebook   String?
  socialTwitter    String?
  socialYoutube    String?
  socialPinterest  String?
  socialWhatsapp   String?

  // SEO
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?

  // Políticas
  shippingPolicy   String?
  returnsPolicy    String?
  privacyPolicy    String?

  // Configuración de tienda
  currency         String?   @default("ARS")
  locale           String?   @default("es-AR")
  showOutOfStock   Boolean   @default(false)
  allowCartGuest   Boolean   @default(true)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model User {
  id       Int    @id @default(autoincrement())
  tenantId Int
  username String
  email    String
  password String
  role     Role   @default(CUSTOMER)

  emailVerified                Boolean   @default(false)
  emailVerificationTokenHash   String?
  emailVerificationExpiresAt   DateTime?

  cart     Cart?
  orders   Order[]
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Categories {
  id          Int          @id @default(autoincrement())
  tenantId    Int
  name        String
  description String?
  icon        String?
  isActive    Boolean      @default(true)
  parentId    Int?
  parent      Categories?  @relation("CategoryToSubcategories", fields: [parentId], references: [id])
  children    Categories[] @relation("CategoryToSubcategories")
  products    Product[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  img         String?
  imgPublicId String?
  name        String
  description String?
  price       Float?
  categoryId  Int?
  isActive    Boolean          @default(true)
  variants    ProductVariant[]
  category    Categories?      @relation(fields: [categoryId], references: [id])
  tenant      Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ProductVariant {
  id          Int             @id @default(autoincrement())
  tenantId    Int
  productId   Int
  color       String?
  size        String?
  price       Float?
  stock       Int
  sku         String
  img         String?
  imgPublicId String?
  isActive    Boolean         @default(true)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Cart {
  id        Int        @id @default(autoincrement())
  tenantId  Int
  userId    Int        @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  items     CartItem[]

  @@index([tenantId])
}

model CartItem {
  id        Int             @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  cart      Cart            @relation(fields: [cartId], references: [id])
  variant   ProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id         Int         @id @default(autoincrement())
  tenantId   Int
  userId     Int
  status     OrderStatus @default(PENDING)
  total      Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id])
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  orderItems OrderItem[]

  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  paymentId       String?
  mercadoPagoId   String?       @unique
  preferenceId    String?

  @@index([tenantId])
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int
  variantId Int
  quantity  Int
  price     Float
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant  @relation(fields: [variantId], references: [id])

  @@unique([orderId, variantId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROCESS
  REFUNDED
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}
